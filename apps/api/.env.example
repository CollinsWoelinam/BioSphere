DATABASE_URL=postgres://biosphere:biosphere@localhost:5544/biosphere
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL=30d
SENSITIVE_GRID_DEG=0.1
# Uploaded photos (metadata-stripped JPEGs). Defaults to apps/api/data/photos.
# PHOTO_DIR=/var/lib/biosphere/photos
MAX_PHOTO_MB=15
