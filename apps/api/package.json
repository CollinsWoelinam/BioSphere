{
  "name": "@biosphere/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "test": "tsx --env-file-if-exists=.env --test test/*.test.ts",
    "user:create": "tsx --env-file-if-exists=.env src/create-user.ts",
    "photos:to-cloudinary": "tsx --env-file-if-exists=.env src/migrate-photos.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "cloudinary": "^2.11.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
